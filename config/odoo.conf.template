[options]
; Genere a chaque demarrage du container par entrypoint.sh (envsubst).
; Ne pas editer le odoo.conf final directement : editer ce template.

admin_passwd = ${ODOO_ADMIN_PASSWORD}
db_host = db
db_port = 5432
db_user = ${POSTGRES_USER}
db_password = ${POSTGRES_PASSWORD}
db_name = ${POSTGRES_DB}
dbfilter = ${ODOO_DB_FILTER}
list_db = ${ODOO_LIST_DB}

addons_path = /mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo

workers = ${ODOO_WORKERS}
max_cron_threads = 1
log_level = ${ODOO_LOG_LEVEL}
logfile = /var/log/odoo/odoo.log

; Le reverse proxy (Nginx/Traefik) sera place devant Odoo en production.
proxy_mode = True
