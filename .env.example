# ============================================================
# CaisseCash ERP (Odoo Community) - variables d'environnement
# Copier ce fichier en ".env" et renseigner de VRAIES valeurs.
# Ne JAMAIS committer le fichier ".env" (voir .gitignore).
# ============================================================

# --- PostgreSQL (base dediee a Odoo, separee de la base CaisseCash) ---
POSTGRES_DB=caissecash_erp
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-strong-password
# Port hote pour un acces local optionnel (psql/DBeaver) en DEV uniquement.
# Laisser vide en production : la base ne doit jamais etre exposee.
POSTGRES_HOST_PORT=5434

# --- Odoo ---
ODOO_VERSION=19
ODOO_ADMIN_PASSWORD=change-me-master-password
# Limite les bases visibles/creables a celle-ci (securite : desactive le db manager public)
ODOO_DB_FILTER=^caissecash_erp$
ODOO_LIST_DB=False
ODOO_WORKERS=2
ODOO_LOG_LEVEL=info

# Ports hote exposes (DEV). En PROD, ne pas publier ces ports directement :
# passer par un reverse proxy (Nginx/Traefik) en HTTPS.
ODOO_HOST_PORT=8069
ODOO_LONGPOLLING_HOST_PORT=8072

# --- Fuseau horaire ---
TZ=Africa/Casablanca

# --- Sauvegardes (service backup) ---
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=6
BACKUP_KEEP_MONTHS=6
