<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Étapes du parcours : l'administrateur les affiche ou les masque, les
         renomme et les range (poignée à gauche). -->
    <record id="view_caissecash_journey_step_list" model="ir.ui.view">
        <field name="name">caissecash.journey.step.list</field>
        <field name="model">caissecash.journey.step</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="visible" widget="boolean_toggle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="hint"/>
                <field name="model_name" optional="hide"/>
                <field name="domain" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_caissecash_journey_step" model="ir.actions.act_window">
        <field name="name">Parcours « Du prospect au SAV »</field>
        <field name="res_model">caissecash.journey.step</field>
        <field name="path">parcours-client</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Étapes affichées dans Mon espace : cochez « Affichée », renommez-les et rangez-les avec la poignée.</p>
        </field>
    </record>

    <!-- Paramètres > CaisseCash -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.caissecash</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="CaisseCash" string="CaisseCash" name="caissecash_espace" groups="base.group_system">
                    <block title="Mon espace" name="caissecash_home_settings">
                        <setting id="caissecash_weekly_goal" string="Objectif de l'équipe par semaine"
                                 help="Nombre de tâches terminées que l'équipe vise chaque semaine (classement de Mon espace).">
                            <field name="caissecash_weekly_goal" class="oe_inline"/>
                            <span class="ms-1">tâches</span>
                        </setting>
                        <setting id="caissecash_journey" string="Parcours « Du prospect au SAV »"
                                 help="Étapes affichées dans Mon espace : les afficher ou les masquer, les renommer, changer leur ordre.">
                            <button name="%(caissecash_espace.action_caissecash_journey_step)d" type="action"
                                    string="Régler les étapes" icon="oi-arrow-right" class="btn-link"/>
                        </setting>
                        <setting id="caissecash_quotes" string="Phrases de motivation"
                                 help="Une phrase par ligne ; Mon espace en affiche une différente chaque jour.">
                            <field name="caissecash_quotes" placeholder="Une phrase par ligne"/>
                        </setting>
                    </block>
                    <block title="Objectifs de l'année" name="caissecash_objective_settings">
                        <setting id="caissecash_objective_plan" string="Cibles de l'année"
                                 help="Fixer ou modifier toutes les cibles de l'année dans un seul tableau.">
                            <button name="%(caissecash_erp.action_caissecash_objective_plan)d" type="action"
                                    string="Fixer les objectifs de l'année" icon="oi-arrow-right" class="btn-link"/>
                        </setting>
                        <setting id="caissecash_objective_gaps" string="Seuils de retard"
                                 help="Écart toléré entre l'avancement réel d'un objectif et ce qui était attendu à la date du jour, en points.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="caissecash_objective_at_risk_gap" class="col-lg-6 o_light_label"/>
                                    <div class="col-lg-6">
                                        <field name="caissecash_objective_at_risk_gap" class="oe_inline"/>
                                        <span class="ms-1">points</span>
                                    </div>
                                </div>
                                <div class="row">
                                    <label for="caissecash_objective_late_gap" class="col-lg-6 o_light_label"/>
                                    <div class="col-lg-6">
                                        <field name="caissecash_objective_late_gap" class="oe_inline"/>
                                        <span class="ms-1">points</span>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_caissecash_settings" model="ir.actions.act_window">
        <field name="name">Réglages CaisseCash</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'caissecash_espace', 'bin_size': False}</field>
    </record>

    <!-- Accès direct depuis l'application Tableau de bord (administrateur). -->
    <menuitem id="menu_caissecash_settings" name="Réglages CaisseCash" parent="caissecash_erp.menu_caissecash_dashboard"
              action="action_caissecash_settings" sequence="95" groups="base.group_system"/>

</odoo>
