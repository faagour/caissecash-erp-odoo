<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Clients : l'essentiel en haut (contact, commerce, infos légales), tout ce
         qui concerne le client en boutons, et une alerte en cas de doublon.
         La fiche Odoo complète reste accessible par un lien. -->

    <record id="view_caissecash_customer_list" model="ir.ui.view">
        <field name="name">caissecash.customer.list</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Clients">
                <field name="name" string="Client"/>
                <field name="commercial_name" optional="show"/>
                <field name="phone" widget="phone" string="Téléphone"/>
                <field name="whatsapp" widget="phone" optional="hide"/>
                <field name="city" string="Ville"/>
                <field name="business_type" optional="show"/>
                <field name="user_id" string="Commercial" widget="many2one_avatar_user" optional="show"/>
                <field name="ice" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_caissecash_customer_form" model="ir.ui.view">
        <field name="name">caissecash.customer.form</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Client">
                <div class="alert alert-warning mb-0 rounded-0" role="alert" invisible="not caissecash_duplicate_message">
                    <i class="fa fa-exclamation-triangle me-1" title="Attention"/>
                    <field name="caissecash_duplicate_message" class="d-inline"/>
                    <field name="caissecash_duplicate_ids" invisible="1"/>
                </div>
                <sheet>
                    <field name="is_company" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_caissecash_establishments" type="object" icon="fa-building" class="oe_stat_button"
                                groups="caissecash_erp.group_commercial,caissecash_erp.group_stock,caissecash_erp.group_technicien,caissecash_erp.group_comptabilite,caissecash_erp.group_stagiaire,caissecash_erp.group_direction">
                            <field name="caissecash_establishment_count" widget="statinfo" string="Établissements"/>
                        </button>
                        <button name="action_caissecash_equipments" type="object" icon="fa-desktop" class="oe_stat_button"
                                groups="caissecash_erp.group_commercial,caissecash_erp.group_stock,caissecash_erp.group_technicien,caissecash_erp.group_stagiaire,caissecash_erp.group_direction">
                            <field name="caissecash_equipment_count" widget="statinfo" string="Matériel installé"/>
                        </button>
                        <button name="action_caissecash_subscriptions" type="object" icon="fa-refresh" class="oe_stat_button"
                                groups="caissecash_erp.group_commercial,caissecash_erp.group_comptabilite,caissecash_erp.group_direction">
                            <field name="caissecash_subscription_count" widget="statinfo" string="Abonnements"/>
                        </button>
                        <button name="action_caissecash_installations" type="object" icon="fa-wrench" class="oe_stat_button"
                                groups="caissecash_erp.group_commercial,caissecash_erp.group_stock,caissecash_erp.group_technicien,caissecash_erp.group_stagiaire,caissecash_erp.group_direction">
                            <field name="caissecash_installation_count" widget="statinfo" string="Installations"/>
                        </button>
                        <button name="action_caissecash_sav_tickets" type="object" icon="fa-life-ring" class="oe_stat_button"
                                groups="caissecash_erp.group_commercial,caissecash_erp.group_stock,caissecash_erp.group_technicien,caissecash_erp.group_stagiaire,caissecash_erp.group_direction">
                            <field name="caissecash_sav_ticket_count" widget="statinfo" string="Tickets SAV"/>
                        </button>
                        <button name="%(sale.act_res_partner_2_sale_order)d" type="action" icon="fa-usd" class="oe_stat_button"
                                groups="sales_team.group_sale_salesman">
                            <field name="sale_order_count" widget="statinfo" string="Devis et ventes"/>
                        </button>
                        <button name="action_view_partner_invoices" type="object" icon="fa-pencil-square-o" class="oe_stat_button"
                                groups="account.group_account_invoice,account.group_account_readonly">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_invoiced" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Facturé</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <field name="avatar_128" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du client (raison sociale)" required="1"/></h1>
                        <field name="commercial_name" placeholder="Nom commercial (enseigne), si différent"/>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="phone" widget="phone" string="Téléphone" placeholder="06 12 34 56 78"/>
                            <field name="whatsapp" widget="phone" placeholder="Si différent du téléphone"/>
                            <field name="email" widget="email"/>
                            <field name="city" string="Ville"/>
                            <field name="street" string="Adresse"/>
                        </group>
                        <group string="Commerce">
                            <field name="business_type"/>
                            <field name="responsable_name" placeholder="Gérant ou propriétaire"/>
                            <field name="user_id" string="Commercial" widget="many2one_avatar_user"/>
                            <field name="source_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Infos légales (pour les factures)">
                        <group>
                            <field name="ice"/>
                            <field name="identifiant_fiscal"/>
                        </group>
                        <group>
                            <field name="rc"/>
                            <field name="taxe_professionnelle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Établissements" name="establishments">
                            <field name="establishment_ids" context="{'default_partner_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="city"/>
                                    <field name="state" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contacts" name="contacts">
                            <field name="child_ids" context="{'default_parent_id': id, 'default_type': 'contact'}">
                                <list editable="bottom">
                                    <field name="name" string="Nom"/>
                                    <field name="function" string="Fonction"/>
                                    <field name="phone" widget="phone" string="Téléphone"/>
                                    <field name="email" widget="email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="comment" placeholder="Horaires, accès, préférences du client…"/>
                        </page>
                    </notebook>
                    <div class="text-end">
                        <button name="action_caissecash_full_form" type="object" icon="fa-sliders" class="btn btn-link"
                                string="Fiche complète (comptabilité, conditions de vente…)" invisible="not id"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_caissecash_customers" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="path">clients</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_customer': 1, 'res_partner_search_mode': 'customer', 'default_is_company': True, 'default_customer_rank': 1, 'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ajoutez votre premier client</p>
            <p>Nom, téléphone et ville suffisent pour commencer ; le reste peut être complété plus tard.</p>
        </field>
    </record>
    <record id="action_caissecash_customers_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_caissecash_customer_list"/>
        <field name="act_window_id" ref="action_caissecash_customers"/>
    </record>
    <record id="action_caissecash_customers_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_caissecash_customer_form"/>
        <field name="act_window_id" ref="action_caissecash_customers"/>
    </record>

    <!-- « Créer > Client » depuis Mon espace : la fiche simplifiée, directement. -->
    <record id="action_caissecash_customer_new" model="ir.actions.act_window">
        <field name="name">Nouveau client</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_caissecash_customer_form"/>
        <field name="target">current</field>
        <field name="context">{'default_is_company': True, 'default_customer_rank': 1, 'default_user_id': uid}</field>
    </record>

</odoo>
