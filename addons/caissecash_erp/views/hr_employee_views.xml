<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherit_caissecash" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.caissecash</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_title']" position="after">
                <field name="relation_type"/>
                <field name="date_start"/>
                <field name="founder_id" invisible="relation_type != 'cofondateur'"/>
            </xpath>
        </field>
    </record>

</odoo>
