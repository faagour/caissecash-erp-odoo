<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_caissecash_installation_tree" model="ir.ui.view">
        <field name="name">caissecash.installation.tree</field>
        <field name="model">caissecash.installation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="establishment_id"/>
                <field name="technician_id"/>
                <field name="date_planned"/>
                <field name="date_done" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_caissecash_installation_kanban" model="ir.ui.view">
        <field name="name">caissecash.installation.kanban</field>
        <field name="model">caissecash.installation</field>
        <field name="arch" type="xml">
            <!-- Odoo 19 : modèle « card » (l'ancien « kanban-box » n'est plus lu
                 et faisait planter l'écran des installations). -->
            <kanban default_group_by="state" class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start gap-2">
                            <field name="partner_id" class="fw-bold flex-grow-1"/>
                            <field name="name" class="text-muted small"/>
                        </div>
                        <field name="establishment_id" class="small"/>
                        <footer class="pt-1">
                            <field name="date_planned" widget="date" class="small text-muted"/>
                            <field name="technician_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_caissecash_installation_form" model="ir.ui.view">
        <field name="name">caissecash.installation.form</field>
        <field name="model">caissecash.installation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object" string="Marquer terminée" class="oe_highlight" invisible="state == 'terminee'"/>
                    <button name="action_create_subscription" type="object" string="Créer un abonnement" invisible="state != 'terminee'"/>
                    <field name="state" widget="statusbar" statusbar_visible="a_planifier,planifiee,preparation,prete,deplacement,en_cours,terminee"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <!-- L'essentiel pour préparer l'intervention ; la fin
                         d'installation et les détails sont dans les onglets. -->
                    <group>
                        <group string="Chez qui">
                            <field name="partner_id"/>
                            <field name="establishment_id" domain="[('partner_id', '=', partner_id)]"/>
                            <field name="address" placeholder="Adresse de l'intervention si différente de l'établissement"/>
                        </group>
                        <group string="Qui et quand">
                            <field name="technician_id" widget="many2one_avatar_user"/>
                            <field name="date_planned"/>
                            <field name="time_slot" placeholder="ex. 09:00 – 11:00"/>
                            <field name="date_done" invisible="state != 'terminee'"/>
                        </group>
                    </group>
                    <group string="Ce qu'on installe">
                        <field name="equipment_ids" widget="many2many_tags" placeholder="Caisse, imprimante, tiroir…"/>
                        <field name="software_module_ids" widget="many2many_tags" placeholder="Logiciels à activer chez le client"/>
                    </group>
                    <notebook>
                        <page string="Checklist" name="checklist">
                            <field name="checklist" placeholder="Étapes à vérifier sur place…"/>
                        </page>
                        <page string="Fin d'installation" name="closing">
                            <group>
                                <group>
                                    <field name="training_done"/>
                                    <field name="customer_validated"/>
                                </group>
                                <group>
                                    <field name="sale_order_id" domain="[('partner_id', '=', partner_id)]"/>
                                </group>
                            </group>
                            <field name="tests_done" placeholder="Tests effectués : impression, paiement, réseau…"/>
                            <field name="observations" placeholder="Remarques pour l'équipe ou le SAV…"/>
                        </page>
                        <page string="Photos" name="photos">
                            <field name="photo_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_caissecash_installation" model="ir.actions.act_window">
        <field name="name">Installations</field>
        <field name="res_model">caissecash.installation</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Planifiez la première installation</p></field>
    </record>

</odoo>
