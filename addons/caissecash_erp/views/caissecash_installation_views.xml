<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_caissecash_installation_tree" model="ir.ui.view">
        <field name="name">caissecash.installation.tree</field>
        <field name="model">caissecash.installation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="establishment_id"/>
                <field name="technician_id"/>
                <field name="date_planned"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_caissecash_installation_kanban" model="ir.ui.view">
        <field name="name">caissecash.installation.kanban</field>
        <field name="model">caissecash.installation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <field name="date_planned"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="partner_id"/></div>
                            <div><field name="date_planned"/></div>
                            <div><field name="technician_id" widget="many2one_avatar_user"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_caissecash_installation_form" model="ir.ui.view">
        <field name="name">caissecash.installation.form</field>
        <field name="model">caissecash.installation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object" string="Marquer terminée" class="oe_highlight" invisible="state == 'terminee'"/>
                    <button name="action_create_subscription" type="object" string="Créer un abonnement" invisible="state != 'terminee'"/>
                    <field name="state" widget="statusbar" statusbar_visible="a_planifier,planifiee,preparation,prete,deplacement,en_cours,terminee"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="establishment_id" domain="[('partner_id', '=', partner_id)]"/>
                            <field name="address"/>
                            <field name="sale_order_id" domain="[('partner_id', '=', partner_id)]"/>
                        </group>
                        <group>
                            <field name="technician_id"/>
                            <field name="date_planned"/>
                            <field name="time_slot"/>
                            <field name="training_done"/>
                            <field name="customer_validated"/>
                        </group>
                    </group>
                    <group string="Matériel et logiciels">
                        <field name="equipment_ids" widget="many2many_tags"/>
                        <field name="software_module_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="checklist"/>
                        </page>
                        <page string="Tests et observations">
                            <field name="tests_done"/>
                            <field name="observations"/>
                        </page>
                        <page string="Photos">
                            <field name="photo_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_caissecash_installation" model="ir.actions.act_window">
        <field name="name">Installations</field>
        <field name="res_model">caissecash.installation</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Planifiez la première installation</p></field>
    </record>

</odoo>
