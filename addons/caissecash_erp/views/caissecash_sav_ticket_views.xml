<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_caissecash_sav_ticket_tree" model="ir.ui.view">
        <field name="name">caissecash.sav.ticket.tree</field>
        <field name="model">caissecash.sav.ticket</field>
        <field name="arch" type="xml">
            <list decoration-danger="priority == '3'" decoration-warning="priority == '2'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="equipment_id"/>
                <field name="technician_id"/>
                <field name="priority" widget="priority"/>
                <field name="date_open"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_caissecash_sav_ticket_kanban" model="ir.ui.view">
        <field name="name">caissecash.sav.ticket.kanban</field>
        <field name="model">caissecash.sav.ticket</field>
        <field name="arch" type="xml">
            <!-- Odoo 19 : modèle « card » (l'ancien « kanban-box » n'est plus lu
                 et faisait planter l'écran des tickets SAV). -->
            <kanban default_group_by="state" class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start gap-2">
                            <field name="partner_id" class="fw-bold flex-grow-1"/>
                            <field name="name" class="text-muted small"/>
                        </div>
                        <field name="category" class="small"/>
                        <footer class="pt-1">
                            <field name="priority" widget="priority"/>
                            <field name="technician_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_caissecash_sav_ticket_form" model="ir.ui.view">
        <field name="name">caissecash.sav.ticket.form</field>
        <field name="model">caissecash.sav.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="nouveau,diagnostic,planifie,en_cours,resolu,ferme"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <!-- L'essentiel pour prendre en charge le ticket ; garantie,
                         facturation et pièces sont dans les onglets. -->
                    <group>
                        <group string="Chez qui">
                            <field name="partner_id"/>
                            <field name="establishment_id" domain="[('partner_id', '=', partner_id)]"/>
                            <field name="contact_name" placeholder="Personne à rappeler sur place"/>
                            <field name="equipment_id"/>
                        </group>
                        <group string="Prise en charge">
                            <field name="category"/>
                            <field name="priority" widget="priority"/>
                            <field name="technician_id" widget="many2one_avatar_user"/>
                            <field name="date_open"/>
                        </group>
                    </group>
                    <label for="description" class="fw-bold"/>
                    <field name="description" placeholder="Ce que le client signale : symptôme, depuis quand, ce qui a déjà été essayé…"/>
                    <notebook>
                        <page string="Diagnostic et actions" name="diagnostic">
                            <group>
                                <field name="diagnostic" placeholder="Cause trouvée…"/>
                                <field name="actions_taken" placeholder="Ce qui a été fait…"/>
                            </group>
                        </page>
                        <page string="Solution" name="resolution">
                            <field name="resolution" placeholder="Solution apportée, à réutiliser pour un problème semblable…"/>
                        </page>
                        <page string="Pièces utilisées" name="parts">
                            <field name="part_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Garantie et facturation" name="billing">
                            <group>
                                <group>
                                    <field name="warranty_id"/>
                                    <field name="under_warranty"/>
                                    <field name="billable"/>
                                </group>
                                <group>
                                    <field name="time_spent" widget="float_time"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="cost"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_caissecash_sav_ticket" model="ir.actions.act_window">
        <field name="name">Tickets SAV</field>
        <field name="res_model">caissecash.sav.ticket</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Ouvrez le premier ticket SAV</p></field>
    </record>

</odoo>
