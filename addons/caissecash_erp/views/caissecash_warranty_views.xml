<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_caissecash_warranty_tree" model="ir.ui.view">
        <field name="name">caissecash.warranty.tree</field>
        <field name="model">caissecash.warranty</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'expiring_soon'" decoration-muted="state in ('expired','cancelled')">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="warranty_type"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_caissecash_warranty_form" model="ir.ui.view">
        <field name="name">caissecash.warranty.form</field>
        <field name="model">caissecash.warranty</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" type="object" string="Annuler" invisible="state == 'cancelled'"/>
                    <button name="action_reactivate" type="object" string="Réactiver" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="a_activer,active,expiring_soon,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="lot_id"/>
                            <field name="partner_id"/>
                            <field name="establishment_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="duration_months"/>
                            <field name="date_end"/>
                            <field name="warranty_type"/>
                        </group>
                    </group>
                    <field name="conditions" placeholder="Conditions de garantie..."/>
                    <notebook>
                        <page string="Interventions associées">
                            <field name="sav_ticket_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date_open"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_caissecash_warranty_search" model="ir.ui.view">
        <field name="name">caissecash.warranty.search</field>
        <field name="model">caissecash.warranty</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id"/>
                <field name="partner_id"/>
                <filter name="expiring_soon" string="Expire bientôt" domain="[('state', '=', 'expiring_soon')]"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
            </search>
        </field>
    </record>

    <record id="action_caissecash_warranty" model="ir.actions.act_window">
        <field name="name">Garanties</field>
        <field name="res_model">caissecash.warranty</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_caissecash_warranty_search"/>
        <field name="context">{'search_default_expiring_soon': 0}</field>
    </record>

</odoo>
