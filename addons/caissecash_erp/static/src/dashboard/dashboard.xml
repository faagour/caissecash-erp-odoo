<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="caissecash_erp.Dashboard">
        <div class="o_ccd" t-att-class="{ 'is-loading': state.loading }">
            <div class="o_ccd_container" t-if="state.data">
                <t t-set="data" t-value="state.data"/>

                <header class="o_ccd_header">
                    <div>
                        <h1>Tableau de bord</h1>
                        <p>Vue financière simplifiée de CaisseCash</p>
                    </div>
                    <div class="o_ccd_filters">
                        <div class="o_ccd_segmented" role="group" aria-label="Période">
                            <button t-foreach="periods" t-as="period" t-key="period.key" type="button"
                                    t-att-class="{ 'is-active': state.period === period.key }"
                                    t-on-click="() => this.setPeriod(period.key)" t-esc="period.label"/>
                        </div>
                        <button type="button" class="btn btn-light o_ccd_refresh" title="Actualiser" t-on-click="refresh">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>
                </header>

                <section class="o_ccd_kpis">
                    <div class="o_ccd_kpi">
                        <span class="o_ccd_kpi_icon" t-attf-style="--chip: {{ colors.invoiced }}"><i class="fa fa-file-text-o"/></span>
                        <div class="o_ccd_kpi_label">Chiffre d'affaires facturé</div>
                        <div class="o_ccd_kpi_value" t-esc="money(kpis.invoiced)"/>
                        <div class="o_ccd_kpi_sub"><t t-esc="kpis.invoice_count"/> facture<t t-if="kpis.invoice_count > 1">s</t></div>
                    </div>
                    <div class="o_ccd_kpi">
                        <span class="o_ccd_kpi_icon" style="--chip: #0ca30c"><i class="fa fa-money"/></span>
                        <div class="o_ccd_kpi_label">Encaissé</div>
                        <div class="o_ccd_kpi_value" t-esc="money(kpis.paid)"/>
                        <div class="o_ccd_kpi_sub"><t t-esc="paidPercent"/> % du facturé</div>
                    </div>
                    <div class="o_ccd_kpi">
                        <span class="o_ccd_kpi_icon" style="--chip: #d03b3b"><i class="fa fa-clock-o"/></span>
                        <div class="o_ccd_kpi_label">À encaisser</div>
                        <div class="o_ccd_kpi_value" t-esc="money(kpis.unpaid)"/>
                        <div class="o_ccd_kpi_sub is-critical" t-if="kpis.unpaid_count">
                            <i class="fa fa-exclamation-circle"/> <t t-esc="kpis.unpaid_count"/> facture<t t-if="kpis.unpaid_count > 1">s</t> en attente
                        </div>
                        <div class="o_ccd_kpi_sub" t-else="">Aucune facture en attente</div>
                    </div>
                    <div class="o_ccd_kpi">
                        <span class="o_ccd_kpi_icon" t-attf-style="--chip: {{ colors.expenses }}"><i class="fa fa-shopping-cart"/></span>
                        <div class="o_ccd_kpi_label">Dépenses</div>
                        <div class="o_ccd_kpi_value" t-esc="money(kpis.expenses)"/>
                        <div class="o_ccd_kpi_sub"><t t-esc="kpis.expense_count"/> dépense<t t-if="kpis.expense_count > 1">s</t> validée<t t-if="kpis.expense_count > 1">s</t></div>
                    </div>
                    <div class="o_ccd_kpi">
                        <span class="o_ccd_kpi_icon" style="--chip: #6250d6"><i class="fa fa-truck"/></span>
                        <div class="o_ccd_kpi_label">Achats confirmés</div>
                        <div class="o_ccd_kpi_value" t-esc="money(kpis.purchases)"/>
                        <div class="o_ccd_kpi_sub">Hors frais annexes</div>
                    </div>
                    <div class="o_ccd_kpi is-result" title="Chiffre d'affaires facturé moins les dépenses">
                        <span class="o_ccd_kpi_icon"><i class="fa fa-line-chart"/></span>
                        <div class="o_ccd_kpi_label">Résultat</div>
                        <div class="o_ccd_kpi_value" t-esc="money(kpis.result)"/>
                        <div class="o_ccd_kpi_sub">
                            <span class="o_ccd_badge" t-if="kpis.result >= 0"><i class="fa fa-caret-up"/> Bénéfice</span>
                            <span class="o_ccd_badge" t-else=""><i class="fa fa-caret-down"/> Déficit</span>
                        </div>
                    </div>
                </section>

                <section class="o_ccd_card o_ccd_objectives">
                    <div class="o_ccd_card_header">
                        <div>
                            <h2>Objectifs <t t-esc="data.objectives.year"/></h2>
                            <span class="o_ccd_card_hint" t-if="data.objectives.items.length" t-esc="objectivesHint"/>
                            <span class="o_ccd_card_hint" t-else="">Fixez les cibles de l’année et suivez-les trimestre par trimestre</span>
                        </div>
                        <button t-if="data.objectives.can_plan" type="button" class="btn btn-light btn-sm" t-on-click="planObjectives">
                            <i class="fa fa-bullseye"/> Fixer les objectifs de l’année
                        </button>
                    </div>
                    <div class="o_ccd_objectives_list" t-if="data.objectives.items.length">
                        <article t-foreach="data.objectives.items" t-as="objective" t-key="objective.id"
                                 t-attf-class="o_ccd_objective is-{{ objective.status }}"
                                 t-on-click="() => this.openRecord('caissecash.objective', objective.id)">
                            <div class="o_ccd_objective_head">
                                <span class="o_ccd_objective_name" t-esc="objective.name"/>
                                <span class="o_ccd_status" t-esc="objective.status_label"/>
                            </div>
                            <div class="o_ccd_objective_meta">
                                <t t-esc="objective.indicator"/><t t-if="objective.user"> · <t t-esc="objective.user.name"/></t>
                            </div>
                            <div class="o_ccd_objective_values">
                                <b t-esc="objective.current"/>
                                <span>/ <t t-esc="objective.target"/></span>
                                <span class="o_ccd_objective_percent"><t t-esc="objective.progress"/> %</span>
                            </div>
                            <div class="o_ccd_objective_track" t-att-title="objective.expected ? 'Attendu aujourd’hui : ' + objective.expected : ''">
                                <div class="o_ccd_objective_fill" t-attf-style="width: {{ objective.bar }}%"/>
                                <span t-if="objective.expected" class="o_ccd_objective_marker" t-attf-style="left: {{ objective.marker }}%"/>
                            </div>
                            <ol class="o_ccd_objective_quarters">
                                <li t-foreach="objective.quarters" t-as="quarter" t-key="quarter.label"
                                    t-attf-class="is-{{ quarter.period }} {{ quarter.value ? 'has-value' : '' }} {{ quarter.reached ? 'is-reached' : '' }}"
                                    t-att-title="quarter.label + ' (' + quarter.months + ') — cible : ' + quarter.target + (quarter.value ? ' · réalisé : ' + quarter.value : '')"
                                    t-esc="quarter.label"/>
                            </ol>
                        </article>
                    </div>
                    <div class="o_ccd_empty" t-else="">
                        Aucun objectif pour <t t-esc="data.objectives.year"/>.
                        <button t-if="data.objectives.can_plan" type="button" class="btn btn-primary btn-sm ms-2" t-on-click="planObjectives">
                            Fixer les objectifs de l’année
                        </button>
                    </div>
                    <div class="o_ccd_card_links">
                        <button type="button" class="btn btn-link btn-sm" t-on-click="openObjectives">Tous les objectifs</button>
                    </div>
                </section>

                <div class="o_ccd_grid">
                    <section class="o_ccd_card o_ccd_span_2">
                        <div class="o_ccd_card_header">
                            <div>
                                <h2>Facturation et dépenses</h2>
                                <span class="o_ccd_card_hint">12 derniers mois</span>
                            </div>
                            <div class="o_ccd_legend">
                                <span><i t-attf-style="background: {{ colors.invoiced }}"/>Facturé</span>
                                <span><i t-attf-style="background: {{ colors.expenses }}"/>Dépenses</span>
                            </div>
                        </div>
                        <div class="o_ccd_chart"><canvas t-ref="barChart"/></div>
                        <div class="o_ccd_card_links">
                            <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.openGraph('action_view_invoice_graph')">Détail des factures</button>
                            <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.openGraph('action_view_expense_graph')">Détail des dépenses</button>
                        </div>
                    </section>

                    <section class="o_ccd_card">
                        <div class="o_ccd_card_header">
                            <div>
                                <h2>Dépenses par catégorie</h2>
                                <span class="o_ccd_card_hint" t-esc="periodLabel"/>
                            </div>
                        </div>
                        <ul class="o_ccd_bars" t-if="data.categories.length">
                            <li t-foreach="data.categories" t-as="category" t-key="category.name">
                                <div class="o_ccd_bars_label">
                                    <span t-esc="category.name"/>
                                    <b t-esc="money(category.amount)"/>
                                </div>
                                <div class="o_ccd_track"><div class="o_ccd_fill" t-attf-style="width: {{ categoryWidth(category) }}%; background: {{ colors.expenses }}"/></div>
                            </li>
                        </ul>
                        <div class="o_ccd_empty" t-else="">Aucune dépense sur la période.</div>
                        <div class="o_ccd_card_links">
                            <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.openGraph('action_view_expense_graph')">Voir le détail</button>
                        </div>
                    </section>

                    <section class="o_ccd_card o_ccd_span_2">
                        <div class="o_ccd_card_header">
                            <div>
                                <h2>Valeur de l'entreprise</h2>
                                <span class="o_ccd_card_hint">Résultat cumulé en fin de mois, 12 derniers mois</span>
                            </div>
                        </div>
                        <div class="o_ccd_chart"><canvas t-ref="lineChart"/></div>
                        <div class="o_ccd_card_links">
                            <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.openGraph('action_view_value_graph')">Voir l'historique complet</button>
                        </div>
                    </section>

                    <section class="o_ccd_card">
                        <div class="o_ccd_card_header">
                            <div>
                                <h2>Capital des associés</h2>
                                <span class="o_ccd_card_hint">Total investi : <b t-esc="money(data.capital_total)"/></span>
                            </div>
                        </div>
                        <ul class="o_ccd_bars" t-if="data.founders.length">
                            <li t-foreach="data.founders" t-as="founder" t-key="founder.id"
                                class="is-clickable" t-on-click="() => this.openRecord('caissecash.founder', founder.id)">
                                <div class="o_ccd_bars_label">
                                    <span t-esc="founder.name"/>
                                    <span><b t-esc="money(founder.capital)"/> · <t t-esc="percent(founder.share)"/> %</span>
                                </div>
                                <div class="o_ccd_track"><div class="o_ccd_fill" t-attf-style="width: {{ founder.share }}%; background: {{ colors.value }}"/></div>
                            </li>
                        </ul>
                        <div class="o_ccd_empty" t-else="">Aucun associé actif.</div>
                        <div class="o_ccd_card_links">
                            <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.openAction('caissecash_erp.action_caissecash_founder_movement')">Voir les mouvements</button>
                        </div>
                    </section>

                    <section class="o_ccd_card o_ccd_span_half">
                        <div class="o_ccd_card_header"><h2>Dernières dépenses</h2></div>
                        <table class="o_ccd_table" t-if="data.latest_expenses.length">
                            <tbody>
                                <tr t-foreach="data.latest_expenses" t-as="expense" t-key="expense.id"
                                    t-on-click="() => this.openRecord('caissecash.expense', expense.id)">
                                    <td class="o_ccd_table_date" t-esc="shortDate(expense.date)"/>
                                    <td>
                                        <div class="o_ccd_table_main" t-esc="expense.label"/>
                                        <div class="o_ccd_table_sub"><t t-esc="expense.category"/><t t-if="expense.founder"> · payé par <t t-esc="expense.founder"/></t></div>
                                    </td>
                                    <td class="o_ccd_table_amount" t-esc="money(expense.amount)"/>
                                </tr>
                            </tbody>
                        </table>
                        <div class="o_ccd_empty" t-else="">Aucune dépense sur la période.</div>
                        <div class="o_ccd_card_links">
                            <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.openAction('caissecash_erp.action_caissecash_expense')">Toutes les dépenses</button>
                        </div>
                    </section>

                    <section class="o_ccd_card o_ccd_span_half">
                        <div class="o_ccd_card_header"><h2>Factures à encaisser</h2></div>
                        <table class="o_ccd_table" t-if="data.unpaid_invoices.length">
                            <tbody>
                                <tr t-foreach="data.unpaid_invoices" t-as="invoice" t-key="invoice.id"
                                    t-on-click="() => this.openRecord('account.move', invoice.id)">
                                    <td>
                                        <div class="o_ccd_table_main" t-esc="invoice.partner"/>
                                        <div class="o_ccd_table_sub" t-esc="invoice.name"/>
                                    </td>
                                    <td t-attf-class="o_ccd_table_date {{ invoice.overdue ? 'is-critical' : '' }}">
                                        <t t-if="invoice.overdue"><i class="fa fa-exclamation-circle"/> En retard · </t>
                                        <t t-esc="shortDate(invoice.due)"/>
                                    </td>
                                    <td class="o_ccd_table_amount" t-esc="money(invoice.amount)"/>
                                </tr>
                            </tbody>
                        </table>
                        <div class="o_ccd_empty" t-else=""><i class="fa fa-check-circle"/> Aucune facture en attente de paiement.</div>
                        <div class="o_ccd_card_links">
                            <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.openGraph('action_view_invoice_graph')">Toutes les factures</button>
                        </div>
                    </section>
                </div>

                <p class="o_ccd_disclaimer">
                    Vue simplifiée, recalculée à chaque ouverture. Elle ne remplace pas le compte de résultat établi par le comptable.
                </p>
            </div>
        </div>
    </t>

</templates>
