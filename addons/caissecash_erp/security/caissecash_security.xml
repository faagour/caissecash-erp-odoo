<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_caissecash" model="ir.module.category">
            <field name="name">CaisseCash ERP</field>
            <field name="sequence">20</field>
        </record>

        <!-- Odoo 19 : res.groups n'a plus de category_id direct. Le classement
             dans Réglages > Utilisateurs passe par res.groups.privilege
             (category_id est porté par la privilege, pas par le groupe).
             Un privilège par rôle : ce sont des rôles indépendants
             (multi-sélection), pas un seul niveau hiérarchique exclusif. -->

        <record id="privilege_commercial" model="res.groups.privilege">
            <field name="name">Commercial</field>
            <field name="category_id" ref="module_category_caissecash"/>
            <field name="sequence">10</field>
        </record>
        <record id="privilege_stock" model="res.groups.privilege">
            <field name="name">Responsable stock</field>
            <field name="category_id" ref="module_category_caissecash"/>
            <field name="sequence">20</field>
        </record>
        <record id="privilege_technicien" model="res.groups.privilege">
            <field name="name">Technicien</field>
            <field name="category_id" ref="module_category_caissecash"/>
            <field name="sequence">30</field>
        </record>
        <!-- Techniquement toujours "group_comptabilite" (id conservé pour ne pas
             casser les droits d'accès déjà en place) mais renommé "Finance" côté
             utilisateur : couvre désormais factures/paiements + associés + dépenses. -->
        <record id="privilege_comptabilite" model="res.groups.privilege">
            <field name="name">Finance</field>
            <field name="category_id" ref="module_category_caissecash"/>
            <field name="sequence">40</field>
        </record>
        <record id="privilege_stagiaire" model="res.groups.privilege">
            <field name="name">Stagiaire</field>
            <field name="category_id" ref="module_category_caissecash"/>
            <field name="sequence">45</field>
        </record>
        <record id="privilege_comptable_externe" model="res.groups.privilege">
            <field name="name">Comptable externe</field>
            <field name="category_id" ref="module_category_caissecash"/>
            <field name="sequence">47</field>
        </record>
        <record id="privilege_direction" model="res.groups.privilege">
            <field name="name">Direction</field>
            <field name="category_id" ref="module_category_caissecash"/>
            <field name="sequence">50</field>
        </record>
        <record id="privilege_admin" model="res.groups.privilege">
            <field name="name">Administrateur</field>
            <field name="category_id" ref="module_category_caissecash"/>
            <field name="sequence">60</field>
        </record>

        <!-- Groupes de base (un par rôle métier), avec des droits Odoo standards
             implicites correspondants (principe du moindre privilège : chacun
             n'accède qu'aux apps standards dont il a réellement besoin). -->

        <record id="group_commercial" model="res.groups">
            <field name="name">Commercial</field>
            <field name="privilege_id" ref="privilege_commercial"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('base.group_partner_manager'))]"/>
        </record>

        <record id="group_stock" model="res.groups">
            <field name="name">Responsable stock</field>
            <field name="privilege_id" ref="privilege_stock"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <record id="group_technicien" model="res.groups">
            <field name="name">Technicien</field>
            <field name="privilege_id" ref="privilege_technicien"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <record id="group_comptabilite" model="res.groups">
            <field name="name">Finance</field>
            <field name="privilege_id" ref="privilege_comptabilite"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <!-- Accès minimal : uniquement ce qui lui est explicitement attribué
             (installations et tickets SAV assignés, comme un technicien junior). -->
        <record id="group_stagiaire" model="res.groups">
            <field name="name">Stagiaire</field>
            <field name="privilege_id" ref="privilege_stagiaire"/>
        </record>

        <!-- Externe à l'entreprise : accès à la Facturation standard uniquement,
             aucun accès aux modèles CaisseCash (associés, dépenses, marges...). -->
        <record id="group_comptable_externe" model="res.groups">
            <field name="name">Comptable externe</field>
            <field name="privilege_id" ref="privilege_comptable_externe"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_direction" model="res.groups">
            <field name="name">Direction</field>
            <field name="privilege_id" ref="privilege_direction"/>
            <field name="implied_ids" eval="[
                (4, ref('group_commercial')),
                (4, ref('group_stock')),
                (4, ref('group_technicien')),
                (4, ref('group_comptabilite')),
                (4, ref('sales_team.group_sale_manager')),
                (4, ref('stock.group_stock_manager')),
                (4, ref('account.group_account_manager')),
                (4, ref('project.group_project_manager')),
            ]"/>
        </record>

        <record id="group_admin" model="res.groups">
            <field name="name">Administrateur CaisseCash ERP</field>
            <field name="privilege_id" ref="privilege_admin"/>
            <field name="implied_ids" eval="[(4, ref('group_direction')), (4, ref('base.group_system'))]"/>
        </record>

        <!-- Règles d'enregistrement : un technicien ne voit que les installations
             et tickets SAV qui lui sont assignés (les autres rôles ne sont pas
             concernés par ces règles, donc non restreints par elles). -->

        <record id="rule_installation_technicien" model="ir.rule">
            <field name="name">Installation : technicien/stagiaire limité à ses interventions</field>
            <field name="model_id" ref="model_caissecash_installation"/>
            <field name="domain_force">[('technician_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_technicien')), (4, ref('group_stagiaire'))]"/>
        </record>

        <record id="rule_sav_ticket_technicien" model="ir.rule">
            <field name="name">Ticket SAV : technicien/stagiaire limité à ses tickets assignés</field>
            <field name="model_id" ref="model_caissecash_sav_ticket"/>
            <field name="domain_force">[('technician_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_technicien')), (4, ref('group_stagiaire'))]"/>
        </record>

        <!-- Objectifs : chacun voit et met à jour les siens, la finance les consulte
             tous, la direction les gère tous (les règles d'un même utilisateur
             s'additionnent : la direction, qui hérite des autres rôles, voit tout). -->
        <record id="rule_objective_own" model="ir.rule">
            <field name="name">Objectif : chacun voit et met à jour ses objectifs</field>
            <field name="model_id" ref="model_caissecash_objective"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_commercial')), (4, ref('group_stock')), (4, ref('group_technicien')), (4, ref('group_comptabilite')), (4, ref('group_stagiaire'))]"/>
        </record>

        <record id="rule_objective_finance_read" model="ir.rule">
            <field name="name">Objectif : la finance consulte tous les objectifs</field>
            <field name="model_id" ref="model_caissecash_objective"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_comptabilite'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_objective_direction" model="ir.rule">
            <field name="name">Objectif : la direction gère tous les objectifs</field>
            <field name="model_id" ref="model_caissecash_objective"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_direction'))]"/>
        </record>

    </data>
</odoo>
